{
  "name": "markdownpic",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run test:unit && npm run build && npm run test:render",
    "test:unit": "node --test tests/model.test.mjs tests/storage.test.mjs tests/async-workflows.test.mjs tests/highlight.test.mjs tests/edits.test.mjs tests/paste.test.mjs tests/share.test.mjs tests/brand.test.mjs tests/render.test.mjs tests/alt-text.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hast-util-to-jsx-runtime": "2.3.6",
    "html-to-image": "1.11.13",
    "katex": "0.18.2",
    "lowlight": "3.3.0",
    "mermaid": "11.17.2",
    "next": "16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
