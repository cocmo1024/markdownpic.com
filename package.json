    "@types/react-dom": "19.2.3",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "6.2.5",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "^8.2.0",
    "wrangler": "^4.131.1"
